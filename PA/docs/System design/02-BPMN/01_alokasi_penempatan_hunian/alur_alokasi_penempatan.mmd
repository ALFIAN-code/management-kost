sequenceDiagram
  autonumber
  actor User as Calon Penghuni / Staf
  actor Admin as Pengelola / Pengawas Gedung
  participant FE as Frontend UI (Web / Mobile)
  participant Sched as Modul Schedule (Core)
  participant Room as Modul Room (Core)
  participant Bus as Internal Event Bus
  participant Fin as Modul Finance (Opsional)
  participant Mid as Gateway Pembayaran (Midtrans)

  User->>FE: Buka Halaman Ketersediaan Kamar
  FE->>Room: GET /api/rooms?building_id=X (Ambil Unit Fisik & Kapasitas)
  FE->>Sched: GET /api/occupancy/availability?room_id=Y&dates=Z
  Sched-->>FE: Return Slot Sisa Kuota Kamar pada Rentang Tanggal
  
  User->>FE: Pilih Unit Kamar & Periode Huni
  FE->>Sched: POST /api/occupancy/requests (building_id, room_id, user_id, start_date, end_date)
  
  Sched->>Room: Cek Kapasitas Maksimal Fisik Unit
  Sched->>Sched: Validasi Anti-Bentrok Jadwal & Kuota Unit
  
  alt Kuota Kamar Penuh / Tanggal Bentrok
    Sched-->>FE: Return Error 422 (Kuota Penuh pada Periode Terpilih)
    FE-->>User: Tampilkan Peringatan Kuota Habis
  else Kuota Tersedia
    Sched->>Sched: Buat Record Alokasi Baru
    
    alt Kasus A: Modul Finance NONAKTIF (Asrama / Mes / Pondok Gratis)
      alt Kebijakan Gedung: SELF_SERVICE_APPROVAL
        Sched->>Sched: Set Status 'pending_approval'
        Admin->>Sched: Review Berkas & Klik 'Setujui'
        Sched->>Sched: Update Status -> 'confirmed'
      else Kebijakan Gedung: SELF_SERVICE_INSTANT
        Sched->>Sched: Set Status Langsung -> 'confirmed'
      else Kebijakan Gedung: ADMIN_ASSIGN_ONLY
        Note over Admin, Sched: Admin langsung assign user tanpa permohonan mandiri
        Sched->>Sched: Set Status Langsung -> 'confirmed'
      end
      
      Sched->>Bus: emit(OccupancyConfirmed)
      Sched-->>FE: Return Konfirmasi Berhasil (Tanpa Invoice)
      FE-->>User: Tampilkan Tiket Penempatan Kamar
      
    else Kasus B: Modul Finance AKTIF (Rumah Kost Komersial)
      Sched->>Sched: Set Status 'pending_payment' (Payment Barrier Terkunci)
      Sched->>Bus: emit(OccupancyCreated)
      
      Bus->>Fin: handle(OccupancyCreated) -> Generate Invoice
      Fin->>Mid: Request SNAP Token Pembayaran
      Mid-->>Fin: Return SNAP Token
      Fin-->>FE: Return Data Invoice & SNAP Token
      FE-->>User: Tampilkan Antarmuka Bayar (VA / QRIS)
      
      User->>Mid: Selesaikan Pembayaran
      Mid-->>Fin: Webhook Callback Settlement
      Fin->>Fin: Update Invoice -> 'paid'
      Fin->>Bus: emit(PaymentSettled)
      
      Bus->>Sched: handle(PaymentSettled) -> Buka Payment Barrier
      Sched->>Sched: Update Status Alokasi -> 'confirmed'
      FE-->>User: Tampilkan Bukti Lunas & Jadwal Huni Terkonfirmasi
    end
    
    opt Tahap Check-in (Tanggal Mulai Tiba)
      Admin->>Sched: Konfirmasi Kehadiran Fisik Penghuni
      Sched->>Sched: Update Status -> 'active' (Sedang Menghuni)
    end
    
    opt Tahap Check-out (Masa Tinggal Berakhir)
      User->>Sched: Pengakhiran Huni / Selesai
      Sched->>Sched: Update Status -> 'completed'
      Sched->>Bus: emit(OccupancyEnded)
      Note over Sched, Room: Kuota Kamar Otomatis Pulih Kembali
    end
  end
