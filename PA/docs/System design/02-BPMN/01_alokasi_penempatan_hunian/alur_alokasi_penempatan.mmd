sequenceDiagram
  autonumber
  actor User as Penghuni / Calon Penghuni
  actor Admin as Pengelola Gedung
  participant FE as Flutter Web (Antarmuka)
  participant Bldg as Modul Building (Core)
  participant Room as Modul Room (Core)
  participant Lease as Modul Lease (Core)
  participant Bus as Internal Event Bus
  participant Fin as Modul Finance (Opsional)
  participant Mid as Gateway Pembayaran (Midtrans)

  User->>FE: Buka Katalog Kamar (pilih gedung)
  FE->>Bldg: GET /api/buildings (filter building_id dari klaim token)
  FE->>Room: GET /api/rooms?building_id=X&status=kosong
  Room-->>FE: Daftar unit kamar kosong beserta harga bulanan
  FE->>Lease: GET /api/leases/availability?room_id=Y
  Lease-->>FE: Status ketersediaan kamar pada periode berjalan

  User->>FE: Pilih unit kamar dan durasi sewa (satuan bulan)
  FE->>Lease: POST /api/leases (room_id, duration_months, start_month)

  Lease->>Bldg: Ambil min_rental_months dari building_settings
  alt Durasi lebih pendek dari minimum sewa gedung
    Lease-->>FE: Error 422 (durasi minimum gedung adalah N bulan)
    FE-->>User: Tampilkan pilihan durasi minimum
  else Durasi memenuhi minimum sewa
    Lease->>Lease: Kunci baris kamar (SELECT ... FOR UPDATE)
    Lease->>Lease: Periksa kontrak aktif yang tumpang tindih

    alt Sudah ada kontrak aktif pada periode yang sama
      Lease-->>FE: Error 422 (kamar sedang diproses atau sudah terisi)
      FE-->>User: Tampilkan peringatan kamar tidak tersedia
    else Kamar tersedia
      Lease->>Lease: Simpan kontrak sewa (status: 'pending_payment')
      Lease->>Bus: emit(LeaseCreated)

      alt Modul Finance AKTIF (rumah kost komersial)
        Bus->>Fin: handle(LeaseCreated) -> Terbitkan invoice periode pertama
        Fin->>Mid: Request SNAP Token (VA / QRIS)
        Mid-->>Fin: Return SNAP Token
        Fin-->>FE: Return invoice dan snap_token
        FE-->>User: Tampilkan antarmuka pembayaran
        User->>Mid: Selesaikan pembayaran
        Mid-->>Fin: Webhook settlement (tanda tangan terverifikasi)
        Fin->>Bus: emit(PaymentSettled)
        Bus->>Lease: handle(PaymentSettled) -> Buka barrier pembayaran
        Lease->>Lease: Set status kontrak -> 'confirmed'
        Lease->>Room: Update status kamar -> 'terisi'
        FE-->>User: Tampilkan bukti lunas dan konfirmasi sewa
      else Modul Finance NONAKTIF (asrama atau mes gratis)
        Lease->>Lease: Set status kontrak -> 'confirmed'
        Lease->>Room: Update status kamar -> 'terisi'
        FE-->>User: Tampilkan konfirmasi sewa
      end
    end
  end
