flowchart TD
  subgraph CONSUMERS [Klien Sistem]
    FlutterApp[Flutter App\n(Mobile client)]
    AIClient[AI Assistant\n(LLM Client)]
  end

  subgraph ADAPTERS [Interface Adapters / Gateways]
    Keycloak[Keycloak IAM\nExternal SSO]
    REST[REST API\nSanctum / Guard]
    MCP[MCP Server\nJSON-RPC Adapter]
  end

  FlutterApp -.->|SSO login| Keycloak
  FlutterApp -->|read & write| REST
  AIClient -.->|MCP host eksternal| MCP
  Keycloak -.->|token JWT| REST

  subgraph MONOLITH [Modular Monolith (Laravel 11)]
    
    subgraph CORE [Tier core, always-on]
      direction TB
      M1[M1: User & Access\nSSO, RBAC, Keycloak Sync]
      M2[M2: Property & Building\nTenant, scoping gedung]
      M3[M3: Room Management\nMaster kamar, aset fisik]
      M4[M4: Occupancy & Schedule\nLinimasa sewa, row lock]
      M5[M5: Occupancy Dashboard\nKPI lintas gedung]
    end

    ModuleGateway((Module Gateway\n& Event Bus))

    subgraph OPTIONAL [Tier opsional, bisa di-toggle]
      direction TB
      O1[O1: Finance & Billing\nInvoice, Midtrans, refund]
      O2[O2: Maintenance\nTiket kerusakan, teknisi]
      O3[O3: Asset & Inventory\nAset dan checklist]
      O4[O4: Guest Logging\nBuku tamu, biaya inap]
      O5[O5: Notification\nWhatsApp, in-app, audit]
    end

    subgraph OUTBOUND [Outbound adapters]
      direction LR
      MidtransAdapter[MidtransAdapter\nimplements Contract]
      ChannelAdapter[Channel adapter\nFonnte / SMTP]
    end
    
    REST --> ModuleGateway
    MCP -.->|read-only| ModuleGateway
    Keycloak -.->|sync user| ModuleGateway
    
    CORE <==> ModuleGateway
    OPTIONAL <==> ModuleGateway

    ModuleGateway -->|PaymentGatewayContract| MidtransAdapter
    ModuleGateway -->|Notification channel| ChannelAdapter
  end

  MidtransAPI[Midtrans API\nPayment Gateway]
  WAEmailAPI[WhatsApp / Email\nProvider notifikasi]
  MySQL[(MySQL Database\nLogical schema separation per module)]

  MidtransAdapter -.-> MidtransAPI
  ChannelAdapter -.-> WAEmailAPI
  
  CORE <-->|schema core| MySQL
  OPTIONAL <-->|schema opsional| MySQL

  classDef core fill:#dcfce7,stroke:#22c55e,stroke-width:2px;
  classDef opt fill:#ffedd5,stroke:#f97316,stroke-width:2px;
  classDef gateway fill:#f3e8ff,stroke:#a855f7,stroke-width:2px;
  classDef ext fill:#fef08a,stroke:#ca8a04,stroke-width:2px;
  classDef adapter fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px;
  
  class M1,M2,M3,M4,M5 core;
  class O1,O2,O3,O4,O5 opt;
  class REST,MCP gateway;
  class Keycloak,MidtransAPI,WAEmailAPI ext;
  class MidtransAdapter,ChannelAdapter adapter;
