flowchart TD
    %% ==========================================
    %% DFD LEVEL 1 (STANDAR AKADEMIS 3 KOLOM)
    %% Sesuai Notasi DeMarco / Yourdon / Gane & Sarson
    %% ==========================================

    %% ENTITAS EKSTERNAL (TERMINATOR KANAN)
    subgraph Entities ["ENTITAS LUAR"]
        Owner["👤 Pemilik Properti (Owner)"]
        Admin["👔 Pengelola Gedung (Admin)"]
        Resident["👥 Penghuni & Calon Penghuni"]
        External["🌐 Layanan Eksternal (Midtrans, WA, AI)"]
    end

    %% PROSES SENTRAL (LINGKARAN TENGAH)
    subgraph Processes ["PROSES TINGKAT 1"]
        P1(("1.0 Kelola Akun & Hak Akses"))
        P2(("2.0 Kelola Master Gedung & Kamar"))
        P3(("3.0 Kelola Alokasi & Jadwal Huni"))
        P4(("4.0 Kelola Transaksi Keuangan"))
        P5(("5.0 Kelola Pemeliharaan & Aset"))
        P6(("6.0 Kelola Buku Tamu & Notifikasi"))
    end

    %% DATA STORES (KOLOM KIRI - PARALEL HORIZONTAL)
    subgraph DataStores ["DATA STORE TERISOLASI"]
        D1[("D1 Data Pengguna & Hak Akses")]
        D2[("D2 Data Gedung & Fasilitas")]
        D3[("D3 Data Kamar & Inventaris")]
        D4[("D4 Data Alokasi & Hunian")]
        D5[("D5 Data Transaksi & Keuangan")]
        D6[("D6 Data Pemeliharaan, Tamu & Log")]
    end

    %% ==========================================
    %% ALIRAN DATA: PROSES 1.0 (AKUN & AKSES)
    %% ==========================================
    Owner -->|"Input: Setup Kebijakan, Admin & Role"| P1
    P1 -->|"Output: Audit Trail & Status Pengguna"| Owner
    P1 <-->|"Write/Read Data Kredensial & Role"| D1

    %% ==========================================
    %% ALIRAN DATA: PROSES 2.0 (GEDUNG & KAMAR)
    %% ==========================================
    Admin -->|"Input: Master Gedung, Kamar, Fasilitas"| P2
    P2 -->|"Output: Info Katalog & Kapasitas Fisik"| Admin
    P2 <-->|"Write/Read Profil Gedung & Aturan"| D2
    P2 -->|"Write: Unit Kamar & Aset Bawaan"| D3

    %% ==========================================
    %% ALIRAN DATA: PROSES 3.0 (ALOKASI & JADWAL)
    %% ==========================================
    Resident -->|"Input: Registrasi & Pilih Kamar Mandiri"| P3
    Admin -->|"Input: Approval & Plotting Hunian"| P3
    P3 -->|"Output: Konfirmasi Slot Kamar & Masa Huni"| Resident
    P3 -->|"Output: Jadwal Check-in / Check-out"| Admin
    D3 -->|"Read: Ketersediaan Kamar & Slot Kasur"| P3
    P3 <-->|"Write/Read: Data Alokasi & Anggota Huni"| D4

    %% ==========================================
    %% ALIRAN DATA: PROSES 4.0 (KEUANGAN & BAYAR)
    %% ==========================================
    D4 -->|"Read: Kontrak Huni Aktif untuk Tagihan"| P4
    P4 -->|"Output: Tagihan Invoice & Kuitansi"| Resident
    Resident -->|"Input: Bukti Konfirmasi Pembayaran"| P4
    P4 -->|"Output: Request Token SNAP"| External
    External -->|"Input: Webhook Callback Settlement"| P4
    P4 -->|"Output: Laporan Arus Kas & Okupansi"| Owner
    P4 <-->|"Write/Read: Data Invoice, Bayar & Kas"| D5

    %% ==========================================
    %% ALIRAN DATA: PROSES 5.0 (PEMELIHARAAN & ASET)
    %% ==========================================
    Resident -->|"Input: Tiket Kerusakan & Foto"| P5
    Admin -->|"Input: Jadwal Servis & Verifikasi"| P5
    P5 -->|"Output: Status Progres Tiket Aduan"| Resident
    P5 -->|"Output: Agenda Servis Preventif H-7"| Admin
    D3 -->|"Read: Kode Aset & Lokasi Kamar"| P5
    P5 <-->|"Write/Read: Tiket Kerusakan & Servis"| D6

    %% ==========================================
    %% ALIRAN DATA: PROSES 6.0 (BUKU TAMU & NOTIF)
    %% ==========================================
    Resident -->|"Input: Tamu Menginap / Berkunjung"| P6
    P6 -->|"Output: Payload Pesan WhatsApp"| External
    External -->|"Input: Delivery Receipt Log"| P6
    External -->|"Input: Query Read-Only AI Tool-Call"| P6
    P6 -->|"Output: Respon Data Teragregasi AI"| External
    P6 <-->|"Write/Read: Data Tamu & Log Pengiriman"| D6

    %% Styling Warna Standar
    style P1 fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    style P2 fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    style P3 fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    style P4 fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    style P5 fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    style P6 fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
