flowchart TD
    %% ==========================================
    %% ENTITAS EKSTERNAL (TERMINATOR)
    %% ==========================================
    Owner["👤 Pemilik Properti (Owner)"]
    Admin["👔 Pengelola Gedung (Admin)"]
    Resident["👥 Penghuni / Calon Penghuni"]
    Midtrans["💳 Midtrans Payment Gateway"]
    NotificationGW["📱 WhatsApp / Email Gateway"]
    AIClient["🤖 External AI Client (MCP Host)"]

    %% ==========================================
    %% SISTEM SENTRAL (PROSES 0.0)
    %% ==========================================
    System(("🏢 SISTEM INFORMASI MANAJEMEN<br/>HUNIAN DINAMIS & PROPERTI<br/>(Core + Optional Modules)"))

    %% ==========================================
    %% ALIRAN DATA MASUK & KELUAR
    %% ==========================================
    %% 1. Owner Flows
    Owner -->|"1. Setup Gedung, Kebijakan Dinamis & Custom Role"| System
    System -->|"2. Laporan Okupansi, Arus Kas & Audit Log"| Owner

    %% 2. Admin Flows
    Admin -->|"3. Input Kamar, Plotting Kamar, Approval Tiket, Jadwal Servis, Pengeluaran"| System
    System -->|"4. Notifikasi Permohonan Kamar, Tiket Aduan, Agenda Servis H-7"| Admin

    %% 3. Resident Flows
    Resident -->|"5. Pemilihan Kamar Mandiri, Tiket Kerusakan, Log Buku Tamu"| System
    System -->|"6. Konfirmasi Alokasi, Tagihan Invoice, Status Perbaikan Fasilitas"| Resident

    %% 4. Midtrans Flows
    System -->|"7. Request SNAP Token & Parameter Transaksi"| Midtrans
    Midtrans -->|"8. Webhook Callback Status Settlement / Expire"| System

    %% 5. Notification Gateway Flows
    System -->|"9. Payload Notifikasi (Pesan, Nomor WA, Event)"| NotificationGW
    NotificationGW -->|"10. Status Delivery Acknowledgement"| System

    %% 6. AI Client Flows
    AIClient -->|"11. JSON-RPC 2.0 Tool Call (Read-only Query)"| System
    System -->|"12. Data Faktual Properti (JSON Grounded Response)"| AIClient

